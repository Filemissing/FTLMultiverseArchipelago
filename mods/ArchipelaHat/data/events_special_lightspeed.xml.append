<FTL>

	<mod:findName type="event" name="REROUTE_MENU">
		<mod:findLike type="choice">
			<mod:selector req="magical_hat_active"/>
			<mod:setAttributes req="smh_superhat_active"/>
			<mod:findLike type="event">
				<mod:setAttributes load="SMH_REROUTE_MENU_HAT"/>
			</mod:findLike>
		</mod:findLike>
	</mod:findName>

	<event name="SMH_REROUTE_MENU_HAT">
		<text>Should you wish it, the magic hat will allow you to travel to any sector you wish.</text>
		<choice hidden="true" max_group="0">
			<text>Nevermind.</text>
			<event>
				<loadEvent>ATLAS_MENU_NOEQUIPMENT</loadEvent>
			</event>
		</choice>
		<choice hidden="true" max_group="1">
			<text>Look for a Generic Sector.</text>
			<event load="SMH_REROUTE_MENU_HAT_GENERIC"/>
		</choice>
		<choice hidden="true" max_group="1">
			<text>Look for a Unique Sector.</text>
			<event load="REROUTE_MENU_HAT"/>
		</choice>
		<choice hidden="true" max_group="1">
			<text>Look for a Secret Sector.</text>
			<event load="SMH_REROUTE_MENU_HAT_SECRET"/>
		</choice>
	</event>

	
	<mod:findName type="event" name="REROUTE_MENU_HAT">
		<mod:findWithChildLike type="choice" child-type="text">
			<mod:selector>Nevermind.</mod:selector>
			<mod:findLike type="event">
				<mod:findLike type="loadEvent">
					<mod:setValue>SMH_REROUTE_MENU_HAT</mod:setValue>
				</mod:findLike>
			</mod:findLike>
		</mod:findWithChildLike>
		<mod:findLike type="text">
			<mod:setValue>You consider your options for a unique sector.</mod:setValue>
		</mod:findLike>
	</mod:findName>
	
