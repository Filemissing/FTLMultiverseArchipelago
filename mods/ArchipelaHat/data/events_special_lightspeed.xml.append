	<mod:findName type="event" name="REROUTE_MENU_LASTSTAND"> <!--Patch below reroute frenzy to be able to use this beyond node 17-->
		<mod:findLike type="choice">
			<mod:selector req="magical_hat_active"/>
			<mod:setAttributes req="smh_superhat_active"/>
			<mod:findLike type="event">
				<mod:setAttributes load="SMH_REROUTE_MENU_HAT"/>
			</mod:findLike>
		</mod:findLike>
	</mod:findName>
		
	<event name="SMH_REROUTE_MENU_HAT_GENERIC">
